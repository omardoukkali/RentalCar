# =============================================================================
#  Variables d'environnement lues par docker-compose
#  Copier ce fichier en .env :   cp .env.example .env
#  (Le .env réel n'est PAS versionné — voir .gitignore)
# =============================================================================

# --- Base de données PostgreSQL ----------------------------------------------
DB_DATABASE=grcm
DB_USERNAME=grcm
DB_PASSWORD=secret
DB_PORT=5432

# --- Ports exposés sur la machine hôte ---------------------------------------
API_PORT=8000     # API Laravel    ->  http://localhost:8000
FRONT_PORT=5173   # Interface Vue  ->  http://localhost:5173
